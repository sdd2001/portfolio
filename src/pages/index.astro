---
import Header from "../components/header.astro";
import "../styles/global.css";
import * as profile from "../../profile/profile.md";
import type { ProjectInfo } from "../models/project-info.ts";
import ProjectSection from "../components/project-section.astro";
import {
  filesMapper,
  personalProjectFiles,
  professionalProjectFiles,
  schoolProjectFiles,
} from "../helper/project-import.ts";
import { getImage } from "../helper/images.ts";
const { title } = Astro.props;

const professionalProjects: Array<ProjectInfo> = filesMapper(
  professionalProjectFiles,
);

const schoolProjects: Array<ProjectInfo> = filesMapper(schoolProjectFiles);

const personalProjects: Array<ProjectInfo> = filesMapper(personalProjectFiles);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <Header
      name={profile.frontmatter.name}
      about={profile.rawContent()}
      jobTitle={profile.frontmatter.jobTitle}
      profilePicture={getImage(profile.frontmatter.image)}
    />
    <ProjectSection
      sectionTitle="Professional projects"
      projects={professionalProjects}
      eyebrow="Various employers"
      sectionSummary="Professional projects I worked on during my career for various employers"
    />
    <ProjectSection
      sectionTitle="School projects"
      projects={schoolProjects}
      eyebrow="Thomas More"
      sectionSummary="relevant projects I worked on during my studies."
    />
    <ProjectSection
      sectionTitle="Personal projects"
      projects={personalProjects}
      sectionSummary="projects I worked on that are not related to any company I worked for."
    />
  </body>
</html>
