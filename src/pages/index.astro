---
import Header from "../components/header.astro";
import "../styles/global.css";
import * as profile from "../../profile/profile.md";
import ProjectCard from "../components/project-card.astro";
const { title } = Astro.props;

const images = import.meta.glob<ImageMetadata>("../images/*.jpg", {
  eager: true,
  import: "default",
});

const showTestCard = false;

const testSkillStack = [
  {
    name: "React",
    backgroundColour: "#e2ebf8",
    textColour: "#0e3162",
    borderColour: "#b0c3dd",
  },
  {
    name: "Typescript",
    backgroundColour: "#e2f8f6",
    textColour: "#0e625b",
    borderColour: "#b0ddda",
  },
];

function getProfileImage(): ImageMetadata {
  const image = images[`../images/${profile.frontmatter.image}`];
  if (!image) throw new Error(`Image not found for profile`);
  return image;
}
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <Header
      name={profile.frontmatter.name}
      about={profile.rawContent()}
      jobTitle={profile.frontmatter.jobTitle}
      profilePicture={getProfileImage()}
    />
    {showTestCard && (
      <div style="padding: 24px">
        <ProjectCard
          projectImage={getProfileImage()}
          employer="Test employer"
          projectName="Test project"
          projectDescription="This is a random description about a test project. This has no added value whatsoever!"
          skillStack={testSkillStack}
          site="https://www.linkedin.com/in/sean-de-decker-03b4a8221/"
          sourceCode="https://github.com/sdd2001/portfolio"
        />
      </div>
    )}
  </body>
</html>
