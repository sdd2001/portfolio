---
import Header from "../components/header.astro";
import "../styles/global.css";
import * as profile from "../../profile/profile.md";
import ProjectCard from "../components/project-card.astro";
import type { ProjectInfo } from "../models/project-info.ts";
import ProjectSection from "../components/project-section.astro";
import type { MarkdownInstance } from "astro";
const { title } = Astro.props;

const images = import.meta.glob<ImageMetadata>("../images/*.{jpg,jpeg,png}", {
  eager: true,
  import: "default",
});

const showTestCard = true;

function getImage(filename: string): ImageMetadata {
  const image = images[`../images/${filename}`];
  if (!image) throw new Error(`Image not found.`);
  return image;
}

// Frontmatter as written in projects/**/*.md: the image is a filename,
// resolved against src/images below.
type ProjectFrontmatter = Omit<
  ProjectInfo,
  "projectImage" | "projectDescription"
> & {
  projectImage: string;
};

const schoolProjectFiles = import.meta.glob<
  MarkdownInstance<ProjectFrontmatter>
>("../../projects/school/*.md", { eager: true });

const schoolProjects: Array<ProjectInfo> = Object.values(
  schoolProjectFiles,
).map((file) => ({
  ...file.frontmatter,
  projectImage: getImage(file.frontmatter.projectImage),
  projectDescription: file.rawContent().trim(),
}));
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <Header
      name={profile.frontmatter.name}
      about={profile.rawContent()}
      jobTitle={profile.frontmatter.jobTitle}
      profilePicture={getImage(profile.frontmatter.image)}
    />
    {showTestCard && (
      <ProjectSection
        sectionTitle="School projects"
        projects={schoolProjects}
        eyebrow="Thomas More"
        sectionSummary="relevant projects I worked on during my studies."
      />
    )}
  </body>
</html>
