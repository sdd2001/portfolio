---
import type { ProjectInfo } from "../models/project-info.ts";
import ProjectCard from "./project-card.astro";
interface Props {
  sectionTitle: string;
  projects: Array<ProjectInfo>
  eyebrow?: string;
  sectionSummary?: string;
}

const { sectionTitle, projects, eyebrow, sectionSummary } = Astro.props;
---

<div class="project-section">
  <div class="section-container">
    <div class="section-heading">
      {eyebrow && <span class="eyebrow">{eyebrow}</span>}
      <h2 class="section-title">{sectionTitle}</h2>
      {sectionSummary && <p class="section-summary">{sectionSummary}</p>}
    </div>
    <div class="projects-container">
      {
        projects.map((project) => (
          <ProjectCard projectInfo={project} />
        ))
      }
    </div>
  </div>
</div>

<style>
  .project-section {
    display: flex;
    flex-direction: row;
    justify-content: center;
    background-color: var(--surface-100);
  }

  .section-container {
    padding: 0 var(--space-8) var(--space-9);
    max-width: 1168px;
  }

  .section-heading {
    padding: var(--space-8) 0 var(--space-5);
    font-size: var(--font-size-body);
    line-height: var(--line-height-body);
    color: var(--ink);
  }

  .section-heading .eyebrow {
    margin-bottom: var(--space-2);
    font-family: var(--font-family-mono), monospace;
    font-size: var(--font-size-label);
    line-height: var(--line-height-label);
    font-weight: var(--font-weight-label);
    letter-spacing: var(--letter-spacing-label);
    text-transform: uppercase;
    color: var(--ink-subtle);
  }

  .section-heading h2 {
    margin: 0;
    font-size: var(--font-size-h2);
    line-height: var(--line-height-h2);
    font-weight: var(--font-weight-h2);
    color: var(--ink);
  }

  .section-heading p {
    margin: var(--space-3) 0 0;
    max-width: var(--content-width);
    color: var(--ink-muted);
  }

  .projects-container {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-6);
  }

  @media (max-width: 770px) {
    .projects-container {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .section-container {
      padding: 0 var(--space-4) var(--space-7);
    }

    .section-heading {
      padding: var(--space-7) 0 var(--space-4);
    }

    .projects-container {
      gap: var(--space-5);
    }
  }
</style>