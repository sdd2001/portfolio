---
import Image from "astro/components/Image.astro";
import { getIconHtml } from "../utils/icon.ts";

interface Props {
  profilePicture: ImageMetadata;
  name: string;
  about: string;
  jobTitle: string;
}

const { profilePicture, name, about, jobTitle } = Astro.props;
const linkedInIconHtml = getIconHtml("linkedin-in");
---

<header class="page-header">
  <div class="header-content">
    <div class="profile-info">
      <span class="job-title">{jobTitle}</span>
      <h1 class="name">{name}</h1>
      <p class="about">{about}</p>
      <div class="button-container">
        <a
          class="header-button"
          href="https://www.linkedin.com/in/sean-de-decker-03b4a8221/"
        >
          <Fragment class="icon" set:html={linkedInIconHtml} />
          <span class="button-text">Contact on LinkedIn</span>
        </a>
      </div>
    </div>
    <Image
      class="profile-picture"
      src={profilePicture}
      alt={name}
      width={320}
      height={400}
      fit="cover"
    />
  </div>
</header>

<style>
  .page-header {
    display: flex;
    flex-direction: row;
    justify-content: center;
    padding: var(--space-9) var(--space-6) var(--space-8);
    background-color: var(--surface-100);
  }

  .header-content {
    display: flex;
    flex-direction: row;
    justify-content: center;
    align-items: center;
    width: 100%;
    max-width: var(--page-width);
    gap: var(--space-7);
  }

  .profile-info {
    display: flex;
    flex-direction: column;
    min-width: 0;
    gap: var(--space-1);
  }

  .job-title {
    font-family: var(--font-family-mono), monospace;
    font-size: var(--font-size-label);
    line-height: var(--line-height-label);
    font-weight: var(--font-weight-label);
    letter-spacing: var(--letter-spacing-label);
    color: var(--ink-subtle);
    padding-bottom: var(--space-2);
  }

  .name {
    font-size: var(--font-size-display);
    line-height: var(--line-height-display);
    font-weight: var(--font-weight-display);
    letter-spacing: var(--letter-spacing-display);
    color: var(--ink);
    padding-bottom: var(--space-4);
  }

  .about {
    font-size: var(--font-size-body-lg);
    line-height: var(--line-height-body-lg);
    font-weight: var(--font-weight-body-lg);
    color: var(--ink-muted);
    padding-bottom: var(--space-6);
  }

  .button-container {
    display: inline-flex;
    flex-direction: row;
    gap: var(--space-5);
  }

  .header-button {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-4);
    border: 1px solid transparent;
    border-radius: var(--radius-md);
    font-weight: var(--font-weight-label);
    font-size: var(--font-size-body);
    line-height: var(--line-height-body);
    text-decoration: none;
    cursor: pointer;
    background: var(--accent);
    color: var(--on-accent);
  }

  .header-button:hover {
    background: var(--accent-hover);
  }

  .header-button:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .header-button .icon {
    display: inline-block;
    width: 1em;
    height: 1em;
    flex: none;
    fill: currentColor;
    vertical-align: -0.125em;
  }

  .profile-picture {
    flex-shrink: 0;
    width: min(100%, 320px);
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: var(--radius-md);
  }

  @media (max-width: 770px) {
    .header-content {
      flex-direction: column;
      align-items: flex-start;
    }
  }

  @media (max-width: 640px) {
    .page-header {
      padding: var(--space-7) var(--space-5);
    }

    .header-content {
      gap: var(--space-5);
    }

    .job-title {
      padding-bottom: var(--space-1);
    }

    .name {
      padding-bottom: var(--space-2);
    }
  }
</style>
