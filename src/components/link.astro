---
import { getIconHtml } from "../utils/icon.ts";

interface Props {
  label: string;
  link: string;
  icon?: string;
}

const { label, link, icon } = Astro.props;
const iconHtml = getIconHtml(icon);
---

<a href={link} class="link-container" target="_blank" rel="noopener noreferrer">
  <span class="link-text">{label}</span>
  {iconHtml && <Fragment class="icon" set:html={iconHtml} />}
</a>

<style>
  .link-container {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-3) 0;
    border: 1px solid transparent;
    border-radius: var(--radius-md);
    font-size: var(--font-size-body);
    line-height: var(--line-height-body);
    font-weight: var(--font-weight-body);
    color: var(--accent);
    text-decoration: none;
    cursor: pointer;
  }

  .link-container:hover {
    color: var(--accent-hover);
  }

  .link-container:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 0;
  }

  .link-container .icon {
    display: inline-block;
    width: 1em;
    height: 1em;
    flex: none;
    fill: currentColor;
    vertical-align: -0.125em;
  }
</style>
